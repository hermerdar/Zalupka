# HTTP / WebSocket server port for the manager + overlay
PORT=4848

# Streamer.bot WebSocket server (Servers/Clients -> WebSocket Server in Streamer.bot)
STREAMERBOT_HOST=127.0.0.1
STREAMERBOT_PORT=8080
STREAMERBOT_ENDPOINT=/
# Optional password if you enabled authentication on the Streamer.bot WS server
STREAMERBOT_PASSWORD=

# Where the SQLite database file is stored
DB_PATH=./data/app.sqlite
